// InvestFund database schema (docs/DATABASE.md). Implemented by the backend agent.
//
// Conventions: tables snake_case plural (@@map), columns snake_case (@map), `id` is a UUID v7
// generated in the app by `core/ids` (`@db.Uuid`, decision D5), `created_at`/`updated_at` as
// timestamptz. The `vector` (pgvector) and `citext` extensions are enabled by the first
// migration (`init_extensions`); vector columns use `Unsupported("vector(n)")` from P4.
//
// No domain models yet: P1 adds the first tables with a normal additive migration.

generator client {
  provider      = "prisma-client-js"
  // Generated into the package (gitignored) so the API image can ship it next to `dist/`.
  output        = "../generated/prisma"
  // `native` for local and CI runs, musl for the Alpine API image (apps/api/Dockerfile).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
