{
  "name": "@investfund/api",
  "version": "0.0.0",
  "private": true,
  "description": "InvestFund REST API (Express + TypeScript, layered modules).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node scripts/clean-dist.mjs && prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "tsx --env-file-if-exists=../../.env ../../infra/seed/seed.ts"
  },
  "dependencies": {
    "@investfund/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@investfund/test-utils": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
