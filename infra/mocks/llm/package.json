{
  "name": "@investfund/mock-llm",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic, fixture-driven OpenAI-compatible mock server for tests and the sandbox (P0-MOCK-01).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
