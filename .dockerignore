# Build context for infra/docker-compose.yml is the repository root. Keep it small and free of
# secrets: nothing below is ever sent to the Docker daemon.
**/node_modules
**/dist
**/build
**/.next
**/out
**/coverage
**/playwright-report
**/test-results
**/storage
**/uploads
**/*.log
**/*.tsbuildinfo
# Regenerated inside the image by `prisma generate`
apps/api/generated
.git
.github
.claude
.vscode
.idea
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
docs
