# InvestFund environment template (docs/OPERATIONS.md §2).
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Only NEXT_PUBLIC_* values reach the browser bundle: never put secrets in them.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# Origin of the web app: the only origin CORS allows (with credentials). Required in production.
WEB_URL=http://localhost:3000
# Express `trust proxy`: false (default), a hop count (1 behind one reverse proxy) or a comma list
# of proxy IPs/CIDRs/loopback. `true` is refused (clients could spoof their IP via X-Forwarded-For).
TRUST_PROXY=false
NEXT_PUBLIC_API_URL=http://localhost:4000
# Development only: shows a "sign in as" field on /login that passes login_hint to the provider
# (useful with infra/mocks/google). Leave empty in production.
NEXT_PUBLIC_AUTH_DEV_HINTS=
NEXT_PUBLIC_API_MOCKING=

# ── Database ────────────────────────────────────────
# Must be a direct or session-mode connection: real-time LISTEN/NOTIFY does not work through a
# transaction-mode pooler (ADR 0003).
DATABASE_URL=postgresql://investfund:investfund@localhost:5432/investfund
# Integration tests create and drop their own databases on this server (role needs CREATEDB).
TEST_DATABASE_URL=postgresql://investfund:investfund@localhost:5432/investfund

# ── Security (generate long random values) ──────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
# Signs the OAuth state cookie.
JWT_REFRESH_SECRET=change-me
REFRESH_TOKEN_TTL_DAYS=30
# AES-256-GCM key for secrets at rest: 32 bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The value below is a well-known DEVELOPMENT-ONLY placeholder; the API refuses it in production.
ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_PREVIOUS_KEYS=
# HMAC key for IP hashes (rate-limit keys). Generate like JWT_ACCESS_SECRET.
IP_HASH_SECRET=change-me

# ── Google sign-in (OAuth 2.0 client, "Web application") ──
# Authorised redirect URI in the Google Cloud console must equal GOOGLE_REDIRECT_URI.
# Sign-in answers 503 until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Point all three at the mock (http://localhost:4020) to develop without a Google account.
GOOGLE_AUTH_BASE_URL=https://accounts.google.com
GOOGLE_OAUTH2_BASE_URL=https://oauth2.googleapis.com
GOOGLE_API_BASE_URL=https://www.googleapis.com

# ── Email (transactional outbox) ────────────────────
# smtp = deliver; log = record "not delivered" (default, no provider); disabled = never send.
EMAIL_DELIVERY=log
EMAIL_DISPATCHER_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="InvestFund <no-reply@investfund.local>"
# Mailpit web UI (local only): http://localhost:8025

# ── Real time ───────────────────────────────────────
# postgres (LISTEN/NOTIFY; required with more than one API instance) or memory (single process).
REALTIME_BUS=postgres

# ── Storage ─────────────────────────────────────────
# Private local-disk storage root. Use a persistent volume in production (docs/OPERATIONS.md §5).
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ── Rate limiting ───────────────────────────────────
# postgres (default; shared by all API processes) or memory (tests/single process; refused in production)
RATE_LIMIT_STORE=postgres
# Sign-in attempts per IP per minute. Raise only for automated test environments.
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Seed (development only) ─────────────────────────
# SEED_ADMIN_EMAIL=you@example.com     grant admin to this account when running `pnpm seed`
# MOCK_GOOGLE_URL=http://localhost:4020 register demo users with the mock provider
