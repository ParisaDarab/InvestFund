# InvestFund environment template.
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# ── App ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Database / cache ────────────────────────────────
DATABASE_URL=postgresql://investfund:investfund@localhost:5432/investfund
REDIS_URL=redis://localhost:6379

# ── Security (generate long random values) ──────────
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# 32-byte key, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me
ENCRYPTION_KEY_VERSION=1

# ── LLM (OpenAI-compatible) ─────────────────────────
# Bootstrap defaults only. Once the admin panel exists, the admin settings stored in the DB take precedence.
LLM_BASE_URL=https://api.openai.com/v1
# Local mock (starts with `docker compose -f infra/docker-compose.yml up -d`): LLM_BASE_URL=http://localhost:4010/v1
LLM_API_KEY=
LLM_MODEL=
LLM_EMBEDDING_MODEL=

# ── Google OAuth / Gmail / Calendar ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Google endpoint base URLs (non-secret). Point all three at the mock (http://localhost:4020)
# to develop without a Google account. In the sandbox the browser-facing GOOGLE_AUTH_BASE_URL
# stays http://localhost:4020; the server-to-server OAUTH2 and API URLs use http://mock-google:4020.
GOOGLE_AUTH_BASE_URL=https://accounts.google.com
GOOGLE_OAUTH2_BASE_URL=https://oauth2.googleapis.com
GOOGLE_API_BASE_URL=https://www.googleapis.com

# ── Storage ─────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ── Email (transactional; Mailpit locally) ──────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="InvestFund <no-reply@investfund.local>"
# Mailpit web UI (local only): http://localhost:8025

# ── Local infrastructure (infra/docker-compose.yml) ──
# Compose reads these from your shell or infra/.env (not this file). Defaults shown; host ports
# are always bound to 127.0.0.1.
# POSTGRES_USER=investfund
# POSTGRES_PASSWORD=investfund
# POSTGRES_DB=investfund
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# MOCK_LLM_PORT=4010
# MOCK_GOOGLE_PORT=4020
# WEB_PORT=3000
